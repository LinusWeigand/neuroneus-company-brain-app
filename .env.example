# --- client (inlined into the bundle at build time; never put secrets here) ---
VITE_MARKETING_URL=https://www.limitless-stack.com
VITE_CONTACT_EMAIL=info@orakis.com

# --- server only (Vercel environment variables) ---
# Neon connection string. May be the same database as the marketing site;
# the app's tables are prefixed app_.
DATABASE_URL=
# Long random string; salts the hashed client IP used for login rate limiting.
THROTTLE_SALT=

# OAuth apps. Redirect URI registered with each provider must be
# https://<app-domain>/api/auth/callback/<google|microsoft>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- outbound mail (password resets) ---
# Resend API key, restricted to sending.
RESEND_API_KEY=
# Must be an address at a domain verified in Resend, or sending is rejected.
MAIL_FROM=Orakis <noreply@neuron.eus>
