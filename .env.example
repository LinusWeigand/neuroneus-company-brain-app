# --- client (inlined into the bundle at build time; never put secrets here) ---
VITE_MARKETING_URL=https://www.limitless-stack.com
VITE_CONTACT_EMAIL=info@orakis.com

# --- server only (Vercel environment variables) ---
# Neon connection string. May be the same database as the marketing site;
# the app's tables are prefixed app_.
DATABASE_URL=
# Long random string; salts the hashed client IP used for login rate limiting.
THROTTLE_SALT=
