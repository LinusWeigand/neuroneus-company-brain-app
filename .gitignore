# Environment / secrets — the important one. Vite inlines VITE_* vars into the
# built bundle, so anything here ends up public at build time; never put a
# server-side secret in a VITE_ var. Commit .env.example (no values) instead.

# Build output
build
*.tsbuildinfo

# Tooling caches
.vite
.cache
.eslintcache
.turbo

# Test / coverage output
coverage
*.lcov
.nyc_output

# Deploy platform linkage (contains your Vercel project + org ids)
.vercel
.netlify

# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment. Vite inlines VITE_* into the client bundle at build time, so
# never put a server secret in a VITE_ variable. The example file is committed
# as documentation and must stay exempt — keep this negation last, or a later
# .env* rule will silently re-ignore it.
.env
.env.*
!.env.example
